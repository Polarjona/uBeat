# Copia este archivo como ".env" y rellena tus datos.
# Sin SMTP_* la app funciona igual, pero los códigos de
# recuperación NO llegan por email (ver README).

# Gmail + contraseña de aplicación:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# Remitente (opcional, por defecto "Artistas App <SMTP_USER>")
# SMTP_FROM=Artistas App <tu-correo@gmail.com>
